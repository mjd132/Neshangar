<Window x:Class="Neshangar.Windows.UsersList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Neshangar.Windows"
        xmlns:converter="clr-namespace:Neshangar.Resources.Converter"
        mc:Ignorable="d"
        Title="Users List"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        MouseDown="Window_MouseDown"
        AllowsTransparency="False"
        >
    <Window.Resources>
        <converter:WidthReducerConverter x:Key="WidthReducerConverter"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="8" />
    </WindowChrome.WindowChrome>
    
    <Border CornerRadius="10" Background="{DynamicResource WindowBackgroundBrush}" Padding="10"
            Effect="{DynamicResource ShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Navigation Bar -->
            <Border Background="{DynamicResource WindowBackgroudBrush}" CornerRadius="10,10,0,0" BorderBrush="#5F5F5F">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Users List" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                               FontSize="16" FontWeight="SemiBold" />

                    <!-- Minimize Button -->
                    <Button Content="🗕" Width="30" Height="30" Grid.Column="1"
                            Click="MinimizeButton_Click" ToolTip="Minimize" 
                            Style="{DynamicResource MinimizeButtonStyle}"/>

                    
                    <Button Content="✖" Width="30" Height="30" Grid.Column="2"
                            Click="CloseButton_Click" ToolTip="Close" 
                            Style="{DynamicResource ExitButtonStyle}"/>
                    
                </Grid>
            </Border>

            <!-- Users List -->
            <ListBox x:Name="UsersListBox" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource ForegroundBrush}"
                     Margin="0,10,0,10">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="4" Margin="4,2" CornerRadius="5"
                                Width="{Binding ActualWidth, ElementName=UsersListBox, Converter={StaticResource WidthReducerConverter}}"
                                HorizontalAlignment="Stretch" 
                                Background="{DynamicResource WindowBackgroudBrush}" >
                            
                            <Grid Width="Auto">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /> <!-- Name -->
                                    <ColumnDefinition Width="*" />   <!-- Space -->
                                    <ColumnDefinition Width="Auto" /> <!-- Status -->
                                    <ColumnDefinition Width="Auto" /> <!-- Remaining Time -->
                                </Grid.ColumnDefinitions>

                                <!-- User Name -->
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Medium"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" />

                                <!-- Status Indicator -->
                                <Border Grid.Column="2" Padding="4"
                                        CornerRadius="5" MinWidth="60" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Status}" FontWeight="Medium" VerticalAlignment="Center" Foreground="White"
                                               FontSize="12"
                                               HorizontalAlignment="Center" />
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Gray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Online">
                                                    <Setter Property="Background" Value="Green" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                    <Setter Property="Background" Value="Red" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Idle">
                                                    <Setter Property="Background" Value="DarkOrange" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="AFK">
                                                    <Setter Property="Background" Value="DarkKhaki" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                    <Setter Property="Background" Value="DarkGray" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Remaining Time -->
                                <TextBlock Grid.Column="3" Margin="6,0"
                                           HorizontalAlignment="Right" Text="{Binding RemainingTimeString}"
                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>
    </Border>
</Window>